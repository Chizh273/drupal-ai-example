# Composer-managed directories.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/contrib/

# Drupal scaffold files (regenerated by composer).
/.editorconfig
/.gitattributes
/recipes/README.txt
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.gitignore
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/example.gitignore
/web/index.php
/web/modules/README.txt
/web/profiles/README.txt
/web/robots.txt
/web/themes/README.txt
/web/update.php
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/default/.gitignore

# Sensitive/generated site files.
/web/sites/*/settings.local.php
/web/sites/*/files/
/web/sites/*/private/

# Presentation planning docs, not part of the shipped example.
PLAN.md
VERIFICATION_FINDINGS.md

# Auto-regenerated by config:export, protects the config dir from web access.
/config/sync/.htaccess

# Editor/agent tooling, local only.
.idea/
.claude/

# OS cruft.
.DS_Store
